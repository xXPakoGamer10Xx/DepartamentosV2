# Variables de entorno para desarrollo
# Copia este archivo como .env y rellena los valores

# Server
NODE_ENV=development
PORT=3001
TZ=America/Mexico_City

# Database
DB_HOST=db
DB_PORT=5432
DB_NAME=departamentos
DB_USER=depas_user
DB_PASSWORD=depas_secret_2024

# JWT — usa un valor aleatorio largo (>=32 chars). En producción el backend NO
# arranca si este valor es el de ejemplo. Genera uno con: openssl rand -hex 48
JWT_SECRET=cambia_este_secreto_muy_largo_y_seguro_2024
JWT_EXPIRES_IN=7d

# CORS — orígenes permitidos en producción (separados por coma)
FRONTEND_URL=https://laspuercotas.xyz

# Google Gemini — detecta los datos de un contrato Word subido (opcional; sin ella se marcan a mano).
# Obtén una clave en https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# LibreOffice (conversión del contrato Word a PDF). Autodetectado; en Docker ya está instalado.
# SOFFICE_PATH=/usr/bin/soffice

# Backup
BACKUP_DIR=/app/backups
BACKUP_CRON=0 4 * * *

# Arrendador (configurable desde la app; estos son solo valores por defecto)
ARRENDADOR_NOMBRE=Nombre del arrendador
ARRENDADOR_DIRECCION=Dirección de la propiedad
